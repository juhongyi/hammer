{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.next",
      "!!node_modules",
      "!!playwright-report",
      "!!test-results",
      "!next-env.d.ts",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "css": { "parser": { "tailwindDirectives": true } }
}
