# Copy to .env.local. Keep credentials server-side; this file contains examples only.
POSTGRES_DB=presentation
POSTGRES_USER=poc
POSTGRES_PASSWORD=local-poc-password
DATABASE_URL=postgresql+psycopg://poc:local-poc-password@localhost:5432/presentation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/ibm-granite/granite-4.0-h-micro
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
MODEL_TIMEOUT_SECONDS=120
# For Next.js local dev; Docker Compose overrides this with the internal API URL.
API_INTERNAL_URL=http://127.0.0.1:8000
