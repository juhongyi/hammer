# Local development examples. Copy to .env and replace the password.
# PostgreSQL applies these values only when initializing an empty data volume.
PRESENTATION_DB_NAME=presentation
PRESENTATION_DB_USER=presentation
PRESENTATION_DB_PASSWORD=change-me-presentation-local-only
ONTOLOGY_DB_NAME=ontology
ONTOLOGY_DB_USER=ontology
ONTOLOGY_DB_PASSWORD=change-me-ontology-local-only

# Override occupied host ports; container ports stay unchanged.
PRESENTATION_WEB_PORT=3000
PRESENTATION_API_PORT=8000
ONTOLOGY_WEB_PORT=3001
ONTOLOGY_API_PORT=8001
