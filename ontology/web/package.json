{
  "name": "@hammer/ontology-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "architecture": "depcruise src --config .dependency-cruiser.mjs",
    "validate": "pnpm lint && pnpm typecheck && pnpm architecture",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "jsdom": "30.1.3",
    "shadcn": "4.21.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vitest": "5.0.5"
  }
}
